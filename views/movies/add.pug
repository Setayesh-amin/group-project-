//- Setayesh's part: Add movie form
extends ../layout

block content

  section.movie-form-page
    .container

      .movie-form-card

        h1 Add Movie

        //- Rolando's part: Validation errors
        if errors && errors.length
          .error-box(role="alert")
            each error in errors
              p= error.msg

        form.movie-form(action="/movies/add" method="POST" novalidate)

          label(for="name")
            | Movie Name

          input#name(
            type="text"
            name="name"
            value=movie.name || ''
            placeholder="Movie title"
            required
          )


          label(for="poster")
            | Poster URL

          input#poster(
            type="text"
            name="poster"
            value=movie.poster || ''
            placeholder="Poster image URL"
            required
          )


          label(for="description")
            | Description

          textarea#description(
            name="description"
            placeholder="Movie description"
            required
          )= movie.description || ''


          label(for="year")
            | Release Year

          input#year(
            type="number"
            name="year"
            value=movie.year || ''
            placeholder="Year"
            required
          )


          fieldset.genre-field
            legend Genre
            .genre-options
                each genre in genres
                    label.genre-check
                        input(
                        type="checkbox"
                        name="genres"
                        value=genre
                        checked=(Array.isArray(movie.genres) ? movie.genres : [movie.genres]).includes(genre)
                        )

                        span= genre

          label(for="rating")
            | Rating

          input#rating(
            type="number"
            name="rating"
            min="0"
            max="10"
            step="0.1"
            value=movie.rating || ''
            placeholder="0.0 - 10.0"
            required
          )


          button.button(
            type="submit"
          )
            | Save Movie
