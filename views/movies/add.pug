extends ../layout

block content

  section.movie-form-page
    .container

      .movie-form-card

        h1 Add Movie

        form.movie-form(method="POST")

          label(for="name")
            | Movie Name

          input#name(
            type="text"
            name="name"
            placeholder="Movie title"
          )


          label(for="poster")
            | Poster URL

          input#poster(
            type="text"
            name="poster"
            placeholder="Poster image URL"
          )


          label(for="description")
            | Description

          textarea#description(
            name="description"
            placeholder="Movie description"
          )


          label(for="year")
            | Release Year

          input#year(
            type="number"
            name="year"
            placeholder="Year"
          )


          fieldset.genre-field
            legend Genre
            .genre-options
                each genre in genres
                    label.genre-check
                        input(
                        type="checkbox"
                        name="genres"
                        value=genre
                        )

                        span= genre

          label(for="rating")
            | Rating

          input#rating(
            type="number"
            name="rating"
            min="0"
            max="10"
            step="0.1"
            placeholder="0.0 - 10.0"
          )


          button.button(
            type="submit"
          )
            | Save Movie