h1 Edit Movie

form(method="POST")

    input(
        type="text"
        name="name"
        value=movie.name
    )

    input(
        type="text"
        name="poster"
        value=movie.poster
        placeholder="Poster image URL"
    )

    textarea(
        name="description"
    )= movie.description

    input(
        type="number"
        name="year"
        value=movie.year
    )

    input(
        type="text"
        name="genres"
        value=movie.genres
    )

    input(
        type="number"
        name="rating"
        value=movie.rating
    )

    button Update