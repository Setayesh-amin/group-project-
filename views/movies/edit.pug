extends ../layout

block content

  section.movie-form-page
    .container

      .movie-form-card

        h1 Edit Movie

        form.movie-form(method="POST")

          label(for="name")
            | Movie Name

          input#name(
            type="text"
            name="name"
            value=movie.name
          )


          label(for="poster")
            | Poster URL

          input#poster(
            type="text"
            name="poster"
            value=movie.poster
          )


          label(for="description")
            | Description

          textarea#description(
            name="description"
          )= movie.description


          label(for="year")
            | Release Year

          input#year(
            type="number"
            name="year"
            value=movie.year
          )


          fieldset.genre-field

            legend Genres

            .genre-options

              each genre in genres

                label.genre-check

                  input(
                    type="checkbox"
                    name="genres"
                    value=genre
                    checked=movie.genres.includes(genre)
                  )

                  span= genre


          label(for="rating")
            | Rating

          input#rating(
            type="number"
            name="rating"
            value=movie.rating
            min="0"
            max="10"
            step="0.1"
          )


          .edit-actions

            button.button(type="submit")
              | Update Movie

        form.delete-form(
          action=`/movies/${movie._id}?_method=DELETE`
          method="POST"
          onsubmit="return confirm('Are you sure you want to delete this movie?')"
        )
          button.button.delete-button(type="submit")
            | Delete Movie
