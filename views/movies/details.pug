extends ../layout

block content

  section.movie-details
    .container

      .details-card

        .details-poster
          img(
            src=movie.poster
            alt=movie.name
          )

        .details-content
          p.eyebrow Movie Details
          h1= movie.name

          .details-meta
            span= movie.year
            span •
            span= movie.genres.join(" / ")
            span •
            span.details-rating
              | ★ #{movie.rating}

          p.details-description
            = movie.description

          if sessionUser && movie.owner && movie.owner.toString() === sessionUser._id.toString()
            .details-actions
              a.button(href=`/movies/${movie._id}/edit`)
                | Edit Movie

              form(
                action=`/movies/${movie._id}?_method=DELETE`
                method="POST"
                onsubmit="return confirm('Are you sure you want to delete this movie?')"
              )
                button.button.delete-button(type="submit")
                  | Delete Movie
