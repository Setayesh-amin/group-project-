extends ../layout

block content

  section.movie-details
    .container

      .details-card

        .details-poster
          img(
            src=movie.poster
            alt=movie.name
          )

        .details-content

          p.eyebrow Movie Details

          h1= movie.name

          .details-meta
            span= movie.year
            span •
            span= movie.genres.join(" / ")
            span •
            span ★ #{movie.rating}

          p.details-description
            = movie.description

            if sessionUser && movie.owner.toString() === sessionUser._id.toString()
              .details-actions
                a.button(href=`/movies/${movie._id}/edit`)
                  | Edit Movie