doctype html
html(lang="en")
  head
    meta(charset="utf-8")
    meta(name="viewport" content="width=device-width, initial-scale=1")

    meta(
      name="description"
      content="ReelVault — a thoughtful movie collection"
    )

    meta(
      name="theme-color"
      content="#111b2c"
    )

    title #{title || "ReelVault"}

    link(
      rel="icon"
      href="/images/reelvault-mark.svg"
      type="image/svg+xml"
    )

    link(
      rel="apple-touch-icon"
      href="/images/reelvault-mark.svg"
    )

    link(
      rel="preconnect"
      href="https://fonts.googleapis.com"
    )

    link(
      rel="preconnect"
      href="https://fonts.gstatic.com"
      crossorigin
    )

    link(
      href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Playfair+Display:ital,wght@0,700;1,700&display=swap"
      rel="stylesheet"
    )

    link(
      rel="stylesheet"
      href="/css/style.css"
    )

    script(
      src="/js/app.js"
      defer
    )


  body
    header.site-header
      .nav-wrap
        a.brand(href="/" aria-label="ReelVault home")
          span.brand-mark
            img(
              src="/images/reelvault-mark.svg"
              alt=""
              width="42"
              height="42"
            )

          span.brand-copy
            strong ReelVault
            small Film collection


        button.nav-toggle(
          type="button"
          aria-label="Toggle navigation"
          aria-expanded="false"
        )
          span
          span

        nav.site-nav(aria-label="Main navigation")
          a(href="/")
            | HOME
          a(href="/browse-movies")
            | BROWSE MOVIES

          if user
            a(
              href="/movies/add"
            )
              | ADD MOVIE

          if user
            a(
              href="/movies/my"
            )
              | MY MOVIES
          else
            a(
              href="/login"
            )
              | MY MOVIES


        .nav-actions
          if user
            span.welcome-user
              | Welcome, #{user.name}
            a.login-link(
              href="/logout"
            )
              | Logout

          else
            a.login-link(
              href="/login"
            )
              | Log in

            a.button.button-small.join-button(
              href="/register"
            )
              span Join ReelVault
              

    main.site-main
      block content

    footer.site-footer
      .footer-orbit.footer-orbit-one
      .footer-orbit.footer-orbit-two

      .container.footer-top
        .footer-intro
          p.eyebrow
            | The credits are only the beginning
          h2
            | Keep the stories that 
            em stay with you.

     
      .container.footer-divider


      .container.footer-grid
        .footer-brand-column
          a.brand.footer-brand(
            href="/"
          )
            span.brand-mark
              img(
                src="/images/reelvault-mark.svg"
                alt="ReelVault Logo"
                width="42"
                height="42"
              )

            span.brand-copy
              strong ReelVault
              small Film collection

          p
            | A thoughtful home for collecting,
            | rating, and sharing the films worth remembering.




        .footer-links
          .footer-column
            p.footer-label
              | Explore

            a(
              href="/movies"
            )
              | Browse films

            a(
              href="/movies?q=&genre=&sort=rating"
            )
              | Top rated

            a(
              href="/movies?q=&genre=&sort=newest"
            )
              | New releases


          .footer-column
            p.footer-label
              | Stay conncted

            a(
              href="#"
            )
              | Instagram ↗

            a(
              href="#"
            )
              | X ↗

            a(
              href="#"
            )
              | GitHub ↗


      .container.footer-bottom
        p
          | © 2026 ReelVault. Made for people who watch the credits.

        .footer-course
          span.footer-dot
          span
            | CPAN 212 · Modern Web Technologies

        p
          | Built by Alexis, Setayesh & Rolando
